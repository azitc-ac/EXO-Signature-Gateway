{
  "version": 1,
  "global": {
    "font_family": "Segoe UI, Calibri, Arial, sans-serif",
    "font_size": "11pt",
    "base_color": "#1f2937",
    "muted_color": "#6b7280",
    "link_color": "#0369a1"
  },
  "blocks": [
    {
      "id": "1",
      "type": "greeting",
      "text": "Mit freundlichen Grüßen"
    },
    {
      "id": "2",
      "type": "spacer",
      "height": 8
    },
    {
      "id": "3",
      "type": "box",
      "radius": 12,
      "filled": true,
      "fill_color": "#f8fafc",
      "border_width": 1,
      "border_color": "#e2e8f0",
      "padding": 14,
      "children": [
        {
          "id": "tc",
          "type": "two_col",
          "left": [
            {
              "id": "logo",
              "type": "logo",
              "url": "data:image/png;base64,",
              "width": 92,
              "alt": "Contoso"
            }
          ],
          "right": [
            {
              "id": "name",
              "type": "name_field",
              "bold": true,
              "color": "base"
            },
            {
              "id": "title",
              "type": "field",
              "field": "jobTitle",
              "color": "muted"
            },
            {
              "id": "firma",
              "type": "field",
              "field": "companyName",
              "bold": true,
              "color": "base"
            },
            {
              "id": "div",
              "type": "divider",
              "color": "#e2e8f0",
              "margin": 6
            },
            {
              "id": "tel",
              "type": "phone",
              "field": "phone",
              "prefix": "📞"
            },
            {
              "id": "mob",
              "type": "mobile",
              "field": "mobilePhone",
              "prefix": "📱"
            },
            {
              "id": "mail",
              "type": "email_link",
              "prefix": "✉️"
            },
            {
              "id": "web",
              "type": "web_link",
              "prefix": "🌐"
            }
          ],
          "divider": false,
          "gap": 16,
          "left_valign": "middle",
          "right_valign": "middle"
        }
      ]
    }
  ]
}