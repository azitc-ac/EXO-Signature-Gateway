# /etc/exo-watchdog/watchdog.env  (chmod 600)
# Vorbefuellt vom Gateway: Erweitert -> Bypass-Waechter -> Waechter hinzufuegen -> cron.
GATEWAY_HEALTH_URL=https://sig.zarenko.net/health
WATCHDOG_TOKEN=<Token aus dem cron-Generator im Gateway>
WATCHDOG_ID=<Waechter-Id aus dem cron-Generator>
EXO_ORGANIZATION=zarenko.onmicrosoft.com
WATCHDOG_APP_ID=<Waechter-App-ID>
WATCHDOG_CERT_PATH=/etc/exo-watchdog/watchdog.pfx
SIG_RULE_NAME=Route via EXO Signature Gateway
FAIL_THRESHOLD=3
